// ─── ENEDIS ─────────────────────────────────────────────────────────────────

const ENEDIS_TOKEN_URL = ‘https://gw.api.enedis.fr/v1/oauth2/token’;
const ENEDIS_API = ‘https://gw.api.enedis.fr’;

// Exchange Enedis authorization code for token
app.post(’/api/enedis/token’, async (req, res) => {
const { code, redirectUri } = req.body;
const clientId = process.env.ENEDIS_CLIENT_ID;
const clientSecret = process.env.ENEDIS_CLIENT_SECRET;

if (!clientId || !clientSecret) {
return res.status(500).json({ error: ‘Variables ENEDIS non configurées sur le serveur’ });
}

try {
const tokenRes = await axios.post(
ENEDIS_TOKEN_URL,
new URLSearchParams({
grant_type: ‘authorization_code’,
client_id: clientId,
client_secret: clientSecret,
code,
redirect_uri: redirectUri,
}),
{ headers: { ‘Content-Type’: ‘application/x-www-form-urlencoded’ } }
);
return res.json(tokenRes.data);
} catch (err) {
return res.status(500).json({ error: ‘Erreur token Enedis’, detail: err.response?.data || err.message });
}
});

