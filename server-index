const PORT = process.env.PORT || 3000;

// ─── DREAME / XIAOMI ────────────────────────────────────────────────────────

const XIAOMI_SERVERS = {
eu: ‘https://eu.api.io.mi.com/app’,
cn: ‘https://api.io.mi.com/app’,
us: ‘https://us.api.io.mi.com/app’,
};

function md5(str) {
return crypto.createHash(‘md5’).update(str).digest(‘hex’);
}

function generateSignature(path, params, ssecurity, nonce) {
const signStr = [path, `_nonce=${nonce}`, `data=${JSON.stringify(params)}`].join(’&’);
const hmac = crypto.createHmac(‘sha256’, Buffer.from(ssecurity, ‘base64’));
hmac.update(signStr);
return hmac.digest(‘base64’);
}

// Login Xiaomi/Dreame
app.post(’/api/dreame/login’, async (req, res) => {
const { email, password, region = ‘eu’ } = req.body;
try {
// Step 1: Get service token
const loginRes = await axios.post(
‘https://account.xiaomi.com/pass/serviceLoginAuth2’,
new URLSearchParams({
user: email,
hash: md5(password).toUpperCase(),
sid: ‘xiaomiio’,
_json: ‘true’,
serviceParam: ‘{“checkSafePhone”:false}’,
}),
{
headers: {
‘Content-Type’: ‘application/x-www-form-urlencoded’,
‘User-Agent’: ‘APP/com.xiaomi.mihome APPV/6.0.103’,
Cookie: ‘sdkVersion=3.4.1; deviceId=smartmyhome’,
},
}
);

```
const raw = loginRes.data.replace('&&&START&&&', '');
const parsed = JSON.parse(raw);

if (parsed.result !== 'ok') {
  return res.status(401).json({ error: 'Identifiants incorrects', detail: parsed.description });
}

// Step 2: Get auth token
const tokenRes = await axios.get(parsed.location, {
  headers: { 'User-Agent': 'APP/com.xiaomi.mihome APPV/6.0.103' },
  maxRedirects: 0,
  validateStatus: s => s < 400,
});

const cookies = tokenRes.headers['set-cookie'] || [];
const serviceToken = cookies
  .find(c => c.includes('serviceToken='))
  ?.split(';')[0]
  ?.replace('serviceToken=', '');

if (!serviceToken) return res.status(401).json({ error: 'Impossible de récupérer le token' });

return res.json({
  userId: parsed.userId,
  ssecurity: parsed.ssecurity,
  serviceToken,
  region,
});
```

} catch (err) {
console.error(‘Dreame login error:’, err.message);
return res.status(500).json({ error: ‘Erreur de connexion Dreame’, detail: err.message });
}
});

// Get Dreame devices
app.post(’/api/dreame/devices’, async (req, res) => {
const { userId, ssecurity, serviceToken, region = ‘eu’ } = req.body;
const server = XIAOMI_SERVERS[region] || XIAOMI_SERVERS.eu;

try {
const nonce = crypto.randomBytes(8).toString(‘base64’);
const params = { getVirtualModel: false, getHuamiDevices: 0 };
const signature = generateSignature(’/home/device_list’, params, ssecurity, nonce);

```
const devRes = await axios.post(`${server}/home/device_list`, JSON.stringify(params), {
  headers: {
    'Content-Type': 'application/json',
    'x-xiaomi-protocal-flag-cli': 'PROTOCAL-HTTP2',
    'MIOT-ENCRYPT-ALGORITHM': 'ENCRYPT-RC4',
    Cookie: `userId=${userId}; serviceToken=${serviceToken}; yetAnotherServiceToken=${serviceToken}`,
    'Signed-Nonce': nonce,
    Signature: signature,
  },
});

const devices = devRes.data?.result?.list?.filter(d =>
  d.model?.toLowerCase().includes('dreame') || d.model?.toLowerCase().includes('roborock')
) || [];

return res.json({ devices });
```

} catch (err) {
return res.status(500).json({ error: ‘Erreur récupération appareils’, detail: err.message });
}
});

