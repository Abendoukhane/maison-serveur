<!-- TOAST -->

<div class="toast" id="toast"></div>

<script>
// ─── STATE ───────────────────────────────────────────────────────────────────
let cfg = {};
let dreameSession = null;
let dreameDeviceId = null;
let energyTab = 'day';
let robotPollInterval = null;
let energyData = { day: [], week: [], month: [] };

// ─── INIT ────────────────────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  updateLockClock();
  setInterval(updateLockClock, 1000);
  setGreeting();
  cfg = loadConfig();

  // Check if WebAuthn / Face ID is available
  if (!window.PublicKeyCredential) {
    document.querySelector('.lock-hint').textContent = 'Appuyez pour déverrouiller';
  }
});

function updateLockClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2, '0');
  const m = String(now.getMinutes()).padStart(2, '0');
  document.getElementById('lockTime').textContent = `${h}:${m}`;
  document.getElementById('lockDate').textContent = now.toLocaleDateString('fr-FR', {
    weekday: 'long', day: 'numeric', month: 'long'
  });
}

function setGreeting() {
  const h = new Date().getHours();
  const g = h < 12 ? 'Bonjour' : h < 18 ? 'Bon après-midi' : 'Bonsoir';
  document.getElementById('greeting').textContent = g;
}

// ─── FACE ID / WEBAUTHN ──────────────────────────────────────────────────────
async function triggerFaceID() {
  // Try WebAuthn (Face ID on iPhone)
  if (window.PublicKeyCredential) {
    try {
      const challenge = new Uint8Array(32);
      crypto.getRandomValues(challenge);

      // Check if we have a registered credential
      const credId = localStorage.getItem('credentialId');

      if (!credId) {
        // First time: register
        await registerBiometric();
        return;
      }

      // Authenticate
      const assertion = await navigator.credentials.get({
        publicKey: {
          challenge,
          timeout: 60000,
          userVerification: 'required',
          allowCredentials: [{
            type: 'public-key',
            id: base64ToBuffer(credId),
          }],
        }
      });

      if (assertion) unlock();
    } catch (e) {
      // Fallback: PIN
      showPinFallback();
    }
  } else {
    showPinFallback();
  }
}

async function registerBiometric() {
  try {
    const challenge = new Uint8Array(32);
    crypto.getRandomValues(challenge);
    const userId = new Uint8Array(16);
    crypto.getRandomValues(userId);

    const credential = await navigator.credentials.create({
      publicKey: {
        challenge,
        rp: { name: 'Ma Maison', id: window.location.hostname || 'localhost' },
        user: { id: userId, name: 'proprietaire', displayName: 'Propriétaire' },
        pubKeyCredParams: [{ type: 'public-key', alg: -7 }],
        authenticatorSelection: {
          authenticatorAttachment: 'platform',
          userVerification: 'required',
        },
        timeout: 60000,
      }
    });

    localStorage.setItem('credentialId', bufferToBase64(credential.rawId));
    showToast('Face ID enregistré !');
    unlock();
  } catch (e) {
    showPinFallback();
  }
}

// Simple PIN fallback (1234)
let pinBuffer = '';
function showPinFallback() {
  document.querySelector('.lock-hint').textContent = 'Entrez le code 1-2-3-4';
  pinBuffer = '';
}

document.addEventListener('keydown', e => {
  if (!document.getElementById('lockScreen').classList.contains('hidden')) {
    if ('0123456789'.includes(e.key)) {
      pinBuffer += e.key;
      const dots = ['d1','d2','d3','d4','d5','d6'];
      dots.forEach((id, i) => {
        document.getElementById(id).classList.toggle('filled', i < pinBuffer.length);
      });
      if (pinBuffer.length === 4) {
        if (pinBuffer === '1234') {
          setTimeout(unlock, 200);
        } else {
          pinBuffer = '';
          dots.forEach(id => document.getElementById(id).classList.remove('filled'));
          showToast('Code incorrect');
        }
      }
    }
  }
});

function unlock() {
  document.getElementById('lockScreen').classList.add('hidden');
  const hasCfg = cfg.serverUrl && cfg.dreameEmail && cfg.enedisPdl;
  if (hasCfg) {
    showApp();
  } else {
    document.getElementById('setupScreen').classList.add('visible');
  }
}

// ─── CONFIG ──────────────────────────────────────────────────────────────────
function loadConfig() {
  try { return JSON.parse(localStorage.getItem('maMaisonConfig') || '{}'); } catch { return {}; }
}

function saveSetup() {
  const serverUrl = document.getElementById('serverUrl').value.trim().replace(/\/$/, '');
  const dreameEmail = document.getElementById('dreameEmail').value.trim();
  const dreamePassword = document.getElementById('dreamePassword').value;
  const dreameRegion = document.getElementById('dreameRegion').value.trim() || 'eu';
  const enedisPdl = document.getElementById('enedisPdl').value.trim();
  const enedisToken = document.getElementById('enedisToken').value.trim();

  if (!serverUrl || !dreameEmail || !dreamePassword || !enedisPdl) {
    showToast('Veuillez remplir tous les champs requis');
    return;
  }

  cfg = { serverUrl, dreameEmail, dreamePassword, dreameRegion, enedisPdl, enedisToken };
  localStorage.setItem('maMaisonConfig', JSON.stringify(cfg));
  document.getElementById('setupScreen').classList.remove('visible');
  showApp();
}

function resetSetup() {
  document.getElementById('serverUrl').value = cfg.serverUrl || '';
  document.getElementById('dreameEmail').value = cfg.dreameEmail || '';
  document.getElementById('dreamePassword').value = cfg.dreamePassword || '';
  document.getElementById('dreameRegion').value = cfg.dreameRegion || 'eu';
  document.getElementById('enedisPdl').value = cfg.enedisPdl || '';
  document.getElementById('enedisToken').value = cfg.enedisToken || '';
  document.getElementById('app').classList.remove('visible');
  document.getElementById('tabBar').style.display = 'none';
  document.getElementById('setupScreen').classList.add('visible');
}

// ─── APP SHOW ────────────────────────────────────────────────────────────────
function showApp() {
  document.getElementById('app').classList.add('visible');
  document.getElementById('tabBar').style.display = 'flex';
  updateSettingsDisplay();
  refreshAll();
}

function showTab(tab) {
  ['home', 'settings'].forEach(t => {
    document.getElementById(`tab-${t}`).style.display = t === tab ? 'block' : 'none';
    document.getElementById(`tab-btn-${t}`).classList.toggle('active', t === tab);
  });
}

function updateSettingsDisplay() {
  document.getElementById('settingsServer').textContent = cfg.serverUrl ? '✓ Configuré' : '—';
  document.getElementById('settingsDreame').textContent = cfg.dreameEmail || '—';
  document.getElementById('settingsPdl').textContent = cfg.enedisPdl
    ? cfg.enedisPdl.slice(0,4) + '··' + cfg.enedisPdl.slice(-4) : '—';
}

async function refreshAll() {
  await Promise.all([loginDreame(), loadEnergy(), loadWater()]);
}

// ─── DREAME ──────────────────────────────────────────────────────────────────
async function loginDreame() {
  setRobotLoading(true);
  try {
    const res = await fetch(`${cfg.serverUrl}/api/dreame/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: cfg.dreameEmail,
        password: cfg.dreamePassword,
        region: cfg.dreameRegion,
      }),
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    dreameSession = data;

    // Get devices
    const devRes = await fetch(`${cfg.serverUrl}/api/dreame/devices`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(dreameSession),
    });
    const devData = await devRes.json();
    if (devData.devices?.length > 0) {
      dreameDeviceId = devData.devices[0].did;
      await pollRobotStatus();
      robotPollInterval = setInterval(pollRobotStatus, 30000);
    } else {
      setRobotError('Aucun appareil trouvé');
    }
  } catch (e) {
    setRobotError(e.message);
  }
}

async function pollRobotStatus() {
  if (!dreameSession || !dreameDeviceId) return;
  try {
    const res = await fetch(`${cfg.serverUrl}/api/dreame/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...dreameSession, did: dreameDeviceId }),
    });
    const data = await res.json();
    updateRobotUI(data);
  } catch (e) {
    console.error('Robot status error:', e);
  }
}

const ROBOT_STATUS_MAP = {
  0: { label: 'En veille', color: '#636366', bg: 'rgba(99,99,102,0.2)' },
  1: { label: 'Nettoyage', color: '#30d158', bg: 'rgba(48,209,88,0.2)' },
  2: { label: 'Retour base', color: '#ff9f0a', bg: 'rgba(255,159,10,0.2)' },
  3: { label: 'En charge', color: '#0a84ff', bg: 'rgba(10,132,255,0.2)' },
  4: { label: 'En pause', color: '#ff453a', bg: 'rgba(255,69,58,0.2)' },
  5: { label: 'Terminé', color: '#30d158', bg: 'rgba(48,209,88,0.15)' },
};

function updateRobotUI(data) {
  const props = data?.result || [];
  const get = (siid, piid) => props.find(p => p.siid === siid && p.piid === piid)?.value;

  const battery = get(2, 1) ?? '—';
  const status = get(2, 2) ?? 0;
  const area = get(9, 1) ?? '—';
  const time = get(9, 2) ?? '—';

  const st = ROBOT_STATUS_MAP[status] || ROBOT_STATUS_MAP[0];

  document.getElementById('robotBattery').textContent = battery !== '—' ? `${battery}%` : '—';
  document.getElementById('robotArea').textContent = area !== '—' ? `${area}` : '—';
  document.getElementById('robotTime').textContent = time !== '—' ? `${Math.round(time/60)}min` : '—';
  document.getElementById('batteryFill').style.width = `${battery}%`;
  document.getElementById('batteryFill').style.background =
    battery > 50 ? 'var(--green)' : battery > 20 ? 'var(--orange)' : 'var(--red)';

  const badge = document.getElementById('robotBadge');
  badge.style.background = st.bg;
  badge.style.color = st.color;
  badge.querySelector('.badge-dot').style.background = st.color;
  document.getElementById('robotBadgeText').textContent = st.label;
  document.getElementById('robotSubtitle').textContent = `Dernière mise à jour : ${new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'})}`;

  setRobotLoading(false);
}

function setRobotLoading(loading) {
  const sub = document.getElementById('robotSubtitle');
  if (loading) sub.textContent = 'Connexion…';
}

function setRobotError(msg) {
  document.getElementById('robotSubtitle').textContent = `Erreur : ${msg}`;
  document.getElementById('robotBadgeText').textContent = 'Hors ligne';
}

async function robotCommand(cmd) {
  if (!dreameSession || !dreameDeviceId) { showToast('Robot non connecté'); return; }

  const commands = {
    start: { method: 'action', siid: 2, aiid: 1 },
    pause: { method: 'action', siid: 2, aiid: 2 },
    home:  { method: 'action', siid: 2, aiid: 3 },
  };

  const c = commands[cmd];
  const labels = { start: 'Démarrage…', pause: 'Pause…', home: 'Retour à la base…' };
  showToast(labels[cmd]);

  try {
    await fetch(`${cfg.serverUrl}/api/dreame/command`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        ...dreameSession,
        did: dreameDeviceId,
        ...c,
      }),
    });
    setTimeout(pollRobotStatus, 2000);
  } catch (e) {
    showToast('Erreur commande');
  }
}

// ─── ENEDIS / ÉNERGIE ────────────────────────────────────────────────────────
async function loadEnergy() {
  if (!cfg.enedisPdl || !cfg.enedisToken) {
    document.getElementById('energySub').textContent = 'Token Enedis non configuré';
    return;
  }

  const today = new Date();
  const fmt = d => d.toISOString().split('T')[0];
  const minus = (n) => { const d = new Date(today); d.setDate(d.getDate()-n); return d; };

  try {
    // Daily last 30 days
    const res = await fetch(
      `${cfg.serverUrl}/api/enedis/consumption/daily?token=${cfg.enedisToken}&pdl=${cfg.enedisPdl}&start=${fmt(minus(30))}&end=${fmt(today)}`
    );
    const data = await res.json();
    const intervals = data?.meter_reading?.interval_reading || [];
    energyData.month = intervals.map(r => ({ date: r.date, value: parseFloat(r.value)/1000 }));
    energyData.week = energyData.month.slice(-7);
    energyData.day = energyData.month.slice(-1);

    renderEnergyTab();
  } catch (e) {
    document.getElementById('energySub').textContent = 'Erreur chargement Enedis';
    // Show demo data if error
    renderDemoEnergy();
  }
}

function renderDemoEnergy() {
  const demo = Array.from({length:30}, (_,i) => ({
    date: new Date(Date.now()-i*86400000).toISOString().split('T')[0],
    value: +(Math.random()*8+5).toFixed(2)
  })).reverse();
  energyData.month = demo;
  energyData.week = demo.slice(-7);
  energyData.day = demo.slice(-1);
  renderEnergyTab();
}

function setEnergyTab(tab, btn) {
  energyTab = tab;
  document.querySelectorAll('.energy-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderEnergyTab();
}

function renderEnergyTab() {
  const data = energyData[energyTab === 'day' ? 'day' : energyTab === 'week' ? 'week' : 'month'];
  if (!data || data.length === 0) return;

  const total = data.reduce((s,d) => s+d.value, 0);
  const peak = Math.max(...data.map(d=>d.value));
  const costRate = 0.2276; // €/kWh TTC

  document.getElementById('energyMain').textContent = total.toFixed(energyTab === 'day' ? 2 : 1);
  document.getElementById('energyCost').textContent = `${(total*costRate).toFixed(2)} €`;
  document.getElementById('energyPeak').textContent = peak.toFixed(2);

  const labels = { day: "Aujourd'hui", week: '7 derniers jours', month: '30 derniers jours' };
  document.getElementById('energySub').textContent = labels[energyTab];

  // Chart
  const chart = document.getElementById('energyChart');
  chart.innerHTML = '';
  const maxVal = Math.max(...data.map(d=>d.value), 0.1);
  data.forEach(d => {
    const bar = document.createElement('div');
    bar.className = 'energy-bar';
    const pct = (d.value / maxVal) * 100;
    bar.style.cssText = `height:${pct}%;background:linear-gradient(180deg,#ff9f0a,rgba(255,159,10,0.4));flex:1;border-radius:3px 3px 0 0;min-height:4px`;
    chart.appendChild(bar);
  });
}

// ─── EAU ─────────────────────────────────────────────────────────────────────
function loadWater() {
  const entries = JSON.parse(localStorage.getItem('waterEntries') || '[]');
  renderWater(entries);
}

function saveWaterEntry() {
  const val = parseFloat(document.getElementById('waterInput').value);
  if (isNaN(val) || val <= 0) { showToast('Index invalide'); return; }

  const entries = JSON.parse(localStorage.getItem('waterEntries') || '[]');
  entries.push({ date: new Date().toISOString(), value: val });
  entries.sort((a,b) => new Date(b.date)-new Date(a.date));
  localStorage.setItem('waterEntries', JSON.stringify(entries));

  document.getElementById('waterInput').value = '';
  renderWater(entries);
  showToast('Relevé enregistré ✓');
}

function renderWater(entries) {
  const history = document.getElementById('waterHistory');
  history.innerHTML = '';

  if (entries.length === 0) {
    document.getElementById('waterMain').textContent = '—';
    document.getElementById('waterSub').textContent = 'Aucun relevé enregistré';
    return;
  }

  document.getElementById('waterMain').textContent = entries[0].value.toFixed(1);
  document.getElementById('waterSub').textContent = `Relevé du ${new Date(entries[0].date).toLocaleDateString('fr-FR')}`;

  entries.slice(0, 5).forEach((e, i) => {
    const prev = entries[i+1];
    const diff = prev ? (e.value - prev.value).toFixed(1) : null;
    const row = document.createElement('div');
    row.className = 'water-entry';
    row.innerHTML = `
      <div>
        <div style="font-size:15px;font-weight:500">${e.value.toFixed(1)} m³</div>
        <div class="water-entry-date">${new Date(e.date).toLocaleDateString('fr-FR', {day:'numeric',month:'long'})}</div>
      </div>
      ${diff !== null ? `<div class="water-entry-diff" style="color:${diff>5?'var(--red)':'var(--green)'}">+${diff} m³</div>` : ''}
    `;
    history.appendChild(row);
  });
}

// ─── UTILS ───────────────────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

function bufferToBase64(buf) {
  return btoa(String.fromCharCode(...new Uint8Array(buf)));
}

function base64ToBuffer(b64) {
  return Uint8Array.from(atob(b64), c => c.charCodeAt(0));
}
