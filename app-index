* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body {
  font-family: -apple-system, 'SF Pro Display', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100dvh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ── LOCK SCREEN ── */
#lockScreen {
  position: fixed; inset: 0; z-index: 100;
  background: linear-gradient(160deg, #0d1117 0%, #000510 50%, #010a0a 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 0;
}
#lockScreen.hidden { display: none; }

.lock-time {
  font-size: 72px; font-weight: 200; letter-spacing: -3px;
  color: white; line-height: 1;
  text-shadow: 0 0 40px rgba(10,132,255,0.3);
}
.lock-date {
  font-size: 17px; color: rgba(255,255,255,0.6); margin-top: 6px; font-weight: 400;
}
.lock-icon {
  margin-top: 60px;
  width: 72px; height: 72px;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 1.5px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(20px);
  cursor: pointer;
  transition: all 0.2s;
}
.lock-icon:active { transform: scale(0.93); background: rgba(255,255,255,0.15); }
.lock-icon svg { width: 32px; height: 32px; fill: white; }
.lock-hint {
  margin-top: 16px; font-size: 13px; color: rgba(255,255,255,0.35);
  letter-spacing: 0.3px;
}
.lock-dots {
  display: flex; gap: 10px; margin-top: 32px;
}
.lock-dot {
  width: 10px; height: 10px; border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.4);
  transition: all 0.15s;
}
.lock-dot.filled { background: white; border-color: white; }

/* ── SETUP SCREEN ── */
#setupScreen {
  position: fixed; inset: 0; z-index: 90;
  background: var(--bg);
  display: none;
  flex-direction: column;
  padding: calc(var(--safe-top) + 20px) 20px calc(var(--safe-bottom) + 20px);
  overflow-y: auto;
}
#setupScreen.visible { display: flex; }

.setup-header { margin-bottom: 32px; }
.setup-header h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.5px; }
.setup-header p { color: var(--text2); font-size: 15px; margin-top: 6px; line-height: 1.4; }

.setup-section {
  background: var(--card);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  overflow: hidden;
  margin-bottom: 16px;
}
.setup-section-title {
  padding: 14px 16px 10px;
  font-size: 12px; font-weight: 600;
  color: var(--text2); text-transform: uppercase; letter-spacing: 0.8px;
}
.setup-field {
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  display: flex; flex-direction: column; gap: 6px;
}
.setup-field:first-of-type { border-top: none; }
.setup-field label { font-size: 13px; color: var(--text2); }
.setup-field input {
  background: transparent; border: none; outline: none;
  color: var(--text); font-size: 16px;
  font-family: inherit; width: 100%;
}
.setup-field input::placeholder { color: var(--text3); }

.btn-primary {
  background: var(--accent);
  color: white; border: none; border-radius: var(--radius-sm);
  padding: 16px; font-size: 17px; font-weight: 600;
  width: 100%; cursor: pointer; margin-top: 8px;
  transition: opacity 0.15s;
}
.btn-primary:active { opacity: 0.7; }

.setup-note {
  font-size: 12px; color: var(--text3); text-align: center;
  margin-top: 12px; line-height: 1.5;
}

/* ── MAIN APP ── */
#app {
  display: none;
  flex-direction: column;
  min-height: 100dvh;
  padding-bottom: calc(var(--safe-bottom) + 70px);
}
#app.visible { display: flex; }

/* ── HEADER ── */
.app-header {
  padding: calc(var(--safe-top) + 8px) 20px 16px;
  display: flex; align-items: center; justify-content: space-between;
}
.app-header h1 {
  font-size: 34px; font-weight: 700; letter-spacing: -0.5px;
}
.header-greeting { font-size: 13px; color: var(--text2); font-weight: 400; }
.header-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: linear-gradient(135deg, #0a84ff, #30d158);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 600; cursor: pointer;
}

/* ── SCROLL AREA ── */
.scroll-area {
  flex: 1; overflow-y: auto; padding: 0 16px;
  -webkit-overflow-scrolling: touch;
}
.scroll-area::-webkit-scrollbar { display: none; }

/* ── SECTION TITLE ── */
.section-title {
  font-size: 20px; font-weight: 600; letter-spacing: -0.3px;
  margin: 24px 4px 12px;
}

/* ── CARDS ── */
.card {
  background: var(--card);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  padding: 20px;
  margin-bottom: 12px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16px;
}
.card-title-group { display: flex; align-items: center; gap: 10px; }
.card-icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
}
.card-title { font-size: 16px; font-weight: 600; }
.card-subtitle { font-size: 12px; color: var(--text2); margin-top: 1px; }

/* ── STATUS BADGE ── */
.badge {
  padding: 4px 10px; border-radius: 20px;
  font-size: 12px; font-weight: 600;
  display: inline-flex; align-items: center; gap: 5px;
}
.badge-dot { width: 6px; height: 6px; border-radius: 50%; }

/* ── ROBOT CARD ── */
.robot-status-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16px;
}
.robot-stat {
  text-align: center; flex: 1;
}
.robot-stat-value { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
.robot-stat-label { font-size: 11px; color: var(--text2); margin-top: 2px; }

.robot-battery-bar {
  height: 4px; background: var(--card2); border-radius: 2px;
  margin-bottom: 16px; overflow: hidden;
}
.robot-battery-fill {
  height: 100%; border-radius: 2px;
  transition: width 0.5s ease;
}

.robot-actions {
  display: flex; gap: 8px;
}
.robot-btn {
  flex: 1; padding: 13px 8px;
  border-radius: var(--radius-sm); border: none; cursor: pointer;
  font-size: 14px; font-weight: 600; font-family: inherit;
  transition: all 0.15s;
}
.robot-btn:active { transform: scale(0.96); }
.robot-btn-primary { background: var(--accent); color: white; }
.robot-btn-secondary { background: var(--card2); color: var(--text); }
.robot-btn-danger { background: rgba(255,69,58,0.2); color: var(--red); }

/* ── ENERGY CARD ── */
.energy-big {
  font-size: 48px; font-weight: 700; letter-spacing: -2px;
  line-height: 1;
}
.energy-unit { font-size: 20px; color: var(--text2); font-weight: 400; }
.energy-sub { font-size: 13px; color: var(--text2); margin-top: 4px; }

.energy-chart {
  display: flex; align-items: flex-end; gap: 3px;
  height: 70px; margin: 16px 0;
}
.energy-bar {
  flex: 1; border-radius: 3px 3px 0 0;
  min-height: 4px; transition: height 0.5s ease;
}

.energy-tabs {
  display: flex; gap: 0;
  background: var(--card2); border-radius: 10px; padding: 2px;
  margin-bottom: 16px;
}
.energy-tab {
  flex: 1; padding: 7px; text-align: center;
  font-size: 13px; font-weight: 500; color: var(--text2);
  border-radius: 8px; cursor: pointer; transition: all 0.15s;
  border: none; background: transparent; font-family: inherit;
}
.energy-tab.active { background: var(--card); color: var(--text); font-weight: 600; }

.energy-stats {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 8px; margin-top: 8px;
}
.energy-stat-card {
  background: var(--card2); border-radius: var(--radius-sm);
  padding: 12px; border: 1px solid var(--border);
}
.energy-stat-val { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; }
.energy-stat-lbl { font-size: 11px; color: var(--text2); margin-top: 2px; }

/* ── WATER CARD ── */
.water-input-row {
  display: flex; align-items: center; gap: 10px; margin-top: 8px;
}
.water-input {
  flex: 1; background: var(--card2); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 12px 14px;
  color: var(--text); font-size: 17px; font-family: inherit;
  outline: none;
}
.water-input:focus { border-color: var(--accent); }
.water-btn {
  background: var(--accent); color: white; border: none;
  border-radius: var(--radius-sm); padding: 12px 18px;
  font-size: 15px; font-weight: 600; cursor: pointer;
  font-family: inherit; transition: opacity 0.15s;
}
.water-btn:active { opacity: 0.7; }

.water-history {
  margin-top: 14px; display: flex; flex-direction: column; gap: 6px;
}
.water-entry {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 0; border-bottom: 1px solid var(--border);
}
.water-entry:last-child { border-bottom: none; }
.water-entry-date { font-size: 13px; color: var(--text2); }
.water-entry-val { font-size: 15px; font-weight: 600; }
.water-entry-diff { font-size: 12px; }

/* ── TAB BAR ── */
.tab-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(10,10,10,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--border);
  display: flex;
  padding-bottom: var(--safe-bottom);
}
.tab-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 10px 0 4px; cursor: pointer;
  color: var(--text3); transition: color 0.15s;
  border: none; background: transparent; font-family: inherit;
}
.tab-item.active { color: var(--accent); }
.tab-item svg { width: 24px; height: 24px; margin-bottom: 3px; }
.tab-item span { font-size: 10px; font-weight: 500; }

/* ── TOAST ── */
.toast {
  position: fixed; bottom: calc(var(--safe-bottom) + 80px); left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(50,50,52,0.95);
  backdrop-filter: blur(20px);
  color: white; padding: 12px 20px; border-radius: 20px;
  font-size: 14px; font-weight: 500;
  opacity: 0; transition: all 0.3s ease; pointer-events: none;
  white-space: nowrap; z-index: 50;
  border: 1px solid rgba(255,255,255,0.1);
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── LOADING ── */
.spinner {
  width: 20px; height: 20px;
  border: 2px solid rgba(255,255,255,0.15);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  display: inline-block;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-row {
  display: flex; align-items: center; gap: 10px;
  color: var(--text2); font-size: 14px; padding: 8px 0;
}

/* ── SETTINGS TAB ── */
.settings-section {
  background: var(--card); border-radius: var(--radius);
  border: 1px solid var(--border); overflow: hidden;
  margin-bottom: 12px;
}
.settings-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px; border-bottom: 1px solid var(--border);
}
.settings-row:last-child { border-bottom: none; }
.settings-row-label { font-size: 16px; }
.settings-row-value { font-size: 14px; color: var(--text2); }
.settings-row-action {
  font-size: 14px; color: var(--accent); cursor: pointer;
}

/* ── ANIMATIONS ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-up { animation: fadeUp 0.4s ease forwards; }
.delay-1 { animation-delay: 0.05s; opacity: 0; }
.delay-2 { animation-delay: 0.1s; opacity: 0; }
.delay-3 { animation-delay: 0.15s; opacity: 0; }
.delay-4 { animation-delay: 0.2s; opacity: 0; }
